---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import heroPhoto from '../assets/home/hero.jpg';
import educationPhoto from '../assets/home/education.jpg';
import careersPhoto from '../assets/home/careers.jpg';
import recruitmentPhoto from '../assets/home/recruitment.jpg';
import graduatePhoto from '../assets/home/graduate.jpg';
import studyingPhoto from '../assets/home/studying.jpg';
import teamPhoto from '../assets/home/team.jpg';
import graduationPhoto from '../assets/home/graduation.jpg';

const paths = [
  {
    who: 'Students & Parents',
    title: 'Education Consulting',
    text: 'Career counselling, course and college selection, and admission support for studying in India and abroad.',
    href: '/services#education',
    image: educationPhoto,
    alt: 'Two students with backpacks reading a book together',
    cta: 'Plan your education',
  },
  {
    who: 'Job Seekers',
    title: 'Career Opportunities',
    text: 'Browse open roles, get interview preparation, and have your profile shared with hiring employers. 100% free.',
    href: '/careers',
    cta: 'View job openings',
    image: careersPhoto,
    alt: 'A young man in a job interview across a desk',
  },
  {
    who: 'Employers',
    title: 'Recruitment Services',
    text: 'We source, screen and shortlist candidates for your roles. You stay in control of interviews and hiring.',
    href: '/employers',
    cta: 'Hire through us',
    image: recruitmentPhoto,
    alt: 'Two people shaking hands in an office',
  },
];

// Stock photos (Unsplash licence); sources in src/assets/home/SOURCES.md.
const band = [
  { image: graduatePhoto, alt: 'A smiling graduate adjusting his cap', caption: 'Choosing the right course', pos: 'object-[30%_center]' },
  { image: studyingPhoto, alt: 'Young men studying together at a table', caption: 'Preparing for the next step', pos: 'object-center' },
  { image: teamPhoto, alt: 'A team meeting in a modern office', caption: 'Hiring for growing teams', pos: 'object-[65%_center]' },
  { image: graduationPhoto, alt: 'Graduates in caps and gowns at a ceremony', caption: 'Study in India and abroad', pos: 'object-[35%_center]' },
];

const pillars = [
  { title: 'An integrated approach', text: 'Consulting, recruitment and education under one roof, not isolated services.' },
  { title: 'Practical experience', text: 'Guidance grounded in real industry experience, not generic advice.' },
  { title: 'Personalised guidance', text: 'We start by understanding your aspirations or your business objectives.' },
  { title: 'Lasting relationships', text: 'We go beyond transactions to build capability and long-term trust.' },
];
---

<Layout>
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(232,163,61,0.22),transparent_55%)]"></div>
    <div class="container-x relative grid items-center gap-14 py-16 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:py-24">
      <div>
        <p class="eyebrow text-gold-400">Consulting &middot; Recruitment &middot; Education</p>
        <h1 class="mt-5 text-4xl leading-[1.15] text-white sm:text-5xl xl:text-6xl">
          Where potential meets <span class="text-gold-400">possibility.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
          {site.name} helps students choose the right education path, helps job seekers find meaningful careers, and helps businesses hire the right talent.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/careers" class="btn btn-primary">Explore job openings</a>
          <a href="/employers" class="btn btn-outline">Hire through us</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-300">
          <li class="flex items-center gap-2"><span class="text-gold-400">&#10003;</span> Free for job seekers</li>
          <li class="flex items-center gap-2"><span class="text-gold-400">&#10003;</span> Study in India &amp; abroad</li>
          <li class="flex items-center gap-2"><span class="text-gold-400">&#10003;</span> Based in Siliguri</li>
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div class="absolute -right-3 -bottom-3 hidden h-full w-full rounded-3xl border-2 border-gold-500/60 sm:block"></div>
        <Image src={heroPhoto} alt="Students in a classroom, one standing with books and a backpack" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 45vw, 100vw" loading="eager" fetchpriority="high" class="relative aspect-[4/3] w-full rounded-3xl object-cover shadow-2xl" />
        <div class="absolute -bottom-6 left-4 rounded-xl bg-white px-5 py-3.5 shadow-xl sm:left-6">
          <p class="font-display text-xl font-bold text-navy-900">100% free</p>
          <p class="text-xs text-slate-600">No registration or placement fees for job seekers</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <p class="eyebrow">How we help</p>
      <h2 class="mt-3 max-w-2xl text-3xl sm:text-4xl">The right people, connected with the right opportunities</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {paths.map((p) => (
          <div class="card group flex flex-col overflow-hidden p-0">
            <div class="overflow-hidden">
              <Image src={p.image} alt={p.alt} widths={[480, 800]} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">{p.who}</p>
              <h3 class="mt-2 text-xl">{p.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed">{p.text}</p>
              <a href={p.href} class="mt-6 text-sm font-semibold text-navy-800 hover:text-gold-600">{p.cta} &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gold-500">
    <div class="container-x flex flex-col items-start justify-between gap-6 py-10 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl text-navy-950">Our services are completely free for candidates.</h2>
        <p class="mt-2 text-navy-900/80">No registration, placement or service fees. Ever.</p>
      </div>
      <a href="/careers" class="btn btn-dark shrink-0">Submit your resume</a>
    </div>
  </section>

  <section class="bg-mist py-20">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="eyebrow">Why ELEVATE</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Growth begins with understanding people</h2>
        <p class="mt-5 leading-relaxed">
          We combine practical industry experience with a strong understanding of both individual aspirations and business objectives, to create solutions that deliver real value.
        </p>
        <a href="/about" class="btn btn-dark mt-8">About us</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {pillars.map((p, i) => (
          <div class="card">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-navy-900 text-sm font-bold text-gold-400">0{i + 1}</span>
            <h3 class="mt-4 text-lg">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Every step of the way</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">From classrooms to careers</h2>
        </div>
        <p class="max-w-md leading-relaxed">Whether you're choosing a course, preparing for interviews or building a team, we guide you through it personally.</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {band.map((b) => (
          <figure class="group relative overflow-hidden rounded-2xl">
            <Image src={b.image} alt={b.alt} widths={[360, 720]} sizes="(min-width: 1024px) 25vw, 50vw" class:list={['aspect-[4/5] w-full object-cover transition duration-500 group-hover:scale-105', b.pos]} />
            <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-navy-950/90 to-transparent p-4 pt-14 text-sm font-semibold text-white sm:text-base">{b.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy-900">
    <div class="container-x py-16 text-center">
      <h2 class="text-3xl text-white">Let's talk about what's next for you.</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-300">Whether you're planning your studies, looking for a job, or hiring, we're here to help.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn btn-primary">Contact us</a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn btn-outline">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Layout>
