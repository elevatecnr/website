---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="bg-navy-900 text-white">
    <div class="container-x flex flex-col items-center py-28 text-center">
      <p class="eyebrow text-gold-400">Error 404</p>
      <h1 class="mt-4 text-4xl text-white sm:text-5xl">This page doesn't exist.</h1>
      <p class="mt-5 max-w-xl text-lg text-slate-300">The link may be broken or the page may have moved. Let's get you back on track.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Go to home page</a>
        <a href="/careers" class="btn btn-outline">View job openings</a>
        <a href="/contact" class="btn btn-outline">Contact us</a>
      </div>
    </div>
  </section>
</Layout>
