---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-gold-500/15 blur-3xl"></div>
  <div class="container-x relative py-16 sm:py-20">
    <p class="eyebrow text-gold-400">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-3xl text-white sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">{intro}</p>}
  </div>
</section>
