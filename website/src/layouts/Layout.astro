---
import '../styles/global.css';
import { site, nav } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.name} — education consulting and recruitment in ${site.city}. ${site.tagline}` } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, site.url).href;
const waLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hello ${site.shortName}, I'd like to know more about your services.`)}`;
const socials = Object.entries(site.social).filter(([, url]) => url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur">
      <div class="container-x flex h-16 items-center justify-between gap-4">
        <a href="/" aria-label={`${site.name} home`}>
          <img src="/logo.png" alt={site.name} width="406" height="132" class="h-10 w-auto sm:h-11" />
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                path === item.href ? 'text-navy-900' : 'text-slate-600 hover:text-navy-900',
              ]}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href="/contact" class="btn btn-dark ml-2 py-2.5">Contact Us</a>
        </nav>

        <button id="menu-btn" class="rounded-md p-2 text-navy-900 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
      <nav id="mobile-nav" class="hidden border-t border-slate-200 bg-white lg:hidden" aria-label="Mobile">
        <div class="container-x flex flex-col py-3">
          {nav.map((item) => (
            <a href={item.href} class:list={['rounded-md px-2 py-2.5 text-sm font-medium', path === item.href ? 'text-navy-900' : 'text-slate-600']}>{item.label}</a>
          ))}
          <a href="/contact" class="btn btn-dark mt-2">Contact Us</a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-navy-950 text-slate-300">
      <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
          <img src="/logo-full.png" alt={`${site.name}: ${site.tagline}`} width="615" height="200" loading="lazy" class="h-16 w-auto brightness-0 invert" />
          <p class="mt-4 text-sm font-semibold text-white">{site.name}</p>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-400">
            Education consulting and recruitment, connecting the right people with the right opportunities. Free for candidates.
          </p>
          {socials.length > 0 && (
            <div class="mt-5 flex gap-3">
              {socials.map(([name, url]) => (
                <a href={url} target="_blank" rel="noopener" class="rounded-md border border-white/15 px-3 py-1.5 text-xs font-medium capitalize text-slate-200 hover:bg-white/10">{name}</a>
              ))}
            </div>
          )}
        </div>
        <div>
          <p class="text-sm font-semibold text-white">Explore</p>
          <ul class="mt-4 space-y-2 text-sm">
            {nav.slice(1).map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
            <li><a href="/contact" class="hover:text-white">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">Get in touch</p>
          <ul class="mt-4 space-y-2 text-sm">
            <li><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-white">{site.phone}</a></li>
            {site.email && <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>}
            <li class="whitespace-pre-line">{site.address.join('\n')}</li>
            {site.hours && <li>{site.hours}</li>}
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="container-x flex flex-col gap-2 py-5 text-xs text-slate-500 sm:flex-row sm:justify-between">
          <p>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
          <a href="/privacy" class="hover:text-slate-300">Privacy Policy</a>
        </div>
      </div>
    </footer>

    <a
      href={waLink}
      target="_blank"
      rel="noopener"
      class="fixed right-4 bottom-4 z-50 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105"
      aria-label="Chat with us on WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.45 9.45 0 0 1-4.82-1.32l-.35-.21-3.58.94.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47 2.53 0 4.91.99 6.7 2.78a9.41 9.41 0 0 1 2.77 6.7c0 5.22-4.25 9.47-9.47 9.47zm8.06-17.53A11.33 11.33 0 0 0 12.04.63C5.76.63.65 5.74.65 12.02c0 2.01.52 3.97 1.52 5.69L.55 23.63l6.05-1.59a11.36 11.36 0 0 0 5.43 1.38h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.18-5.9-3.33-8.06z" /></svg>
    </a>

    <script>
      import '../scripts/forms';
      const btn = document.getElementById('menu-btn')!;
      const menu = document.getElementById('mobile-nav')!;
      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
